model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  NEW_REQUEST
  REQUEST_FILLED
  DONOR_ACCEPTED
  ELIGIBLE_AGAIN
  BANK_REQUEST_UPDATE
  BANK_VERIFICATION
  ACHIEVEMENT
  ACCOUNT
}