model DonorServiceArea {
  id          String   @id @default(uuid())
  donorId     String
  upazilaId   String
  unionId     String?

  donor User @relation(fields: [donorId], references: [id], onDelete: Cascade)
  upazila Upazila @relation(fields: [upazilaId], references: [id], onDelete: Cascade)
  union Union? @relation(fields: [unionId], references: [id], onDelete: Cascade)
  
  @@unique([donorId, upazilaId, unionId])
  @@index([unionId])
  @@index([upazilaId])

  @@map("donor-service-areas")
}