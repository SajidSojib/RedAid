model PointTransaction {
  id         String   @id @default(uuid())
  donorId    String
  donationId String?
  points     Int
  reason     String
  createdAt  DateTime @default(now())

  donor    User             @relation(fields: [donorId], references: [id], onDelete: Cascade)
  donation DonationHistory? @relation(fields: [donationId], references: [id])

  @@index([donorId, createdAt])
  @@map("point-transactions")
}

model Achievement {
  id        String          @id @default(uuid())
  donorId   String
  kind      AchievementKind
  code      String // e.g. BRONZE, SILVER, GOLD, MILESTONE_10
  awardedAt DateTime        @default(now())

  donor User @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([donorId, kind, code])
  @@map("achievements")
}

enum AchievementKind {
  BADGE
  CERTIFICATE
}