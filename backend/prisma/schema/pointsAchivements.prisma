model Achievement {
  id        String          @id @default(uuid())
  donorId   String
  kind      AchievementKind
  code      CodeName
  awardedAt DateTime        @default(now())

  donor User @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([donorId, kind, code])
  @@map("achievements")
}

enum AchievementKind {
  BADGE
  CERTIFICATE
}

enum CodeName {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}